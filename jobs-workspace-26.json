        "jsCode": "const items = $input.all(); const now = new Date().toLocaleString('ar-SA', { timeZone: 'Asia/Riyadh' }); let message = 'تم رصد ' + items.length + ' وظيفة جديدة بتاريخ ' + now + ':\\n\\n'; items.forEach(function(item, index) { const title = item.json.title || 'وظيفة'; const officialLink = item.json.officialLink || item.json.link; message += (index + 1) + '. ' + title + '\\n' + officialLink + '\\n\\n'; }); return [{ json: { combinedMessage: message, jobCount: items.length } }];"

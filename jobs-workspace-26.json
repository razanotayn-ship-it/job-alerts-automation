        "jsCode": "const htmlData = $('HTML').first().json; const newTitles = htmlData.jobTitles || []; const newLinks = htmlData.jobLinks || []; const storedRows = $input.all(); const storedLinks = storedRows.map(row => row.json.jobLink); const newJobs = []; for (let i = 0; i < newLinks.length; i++) { if (!storedLinks.includes(newLinks[i])) { newJobs.push({ json: { title: newTitles[i], link: newLinks[i] } }); } } return newJobs;"
